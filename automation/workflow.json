{
  "name": "Califnco Daily Instagram Product Post",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] } }, "id": "daily-trigger", "name": "Daily at 09:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 200] },
    { "parameters": { "url": "https://sheets.googleapis.com/v4/spreadsheets/{{$env.GOOGLE_SHEETS_DOCUMENT_ID}}/values/Products!A:H", "authentication": "predefinedCredentialType", "nodeCredentialType": "googleSheetsOAuth2Api", "options": {} }, "id": "read-products", "name": "Read product schedule", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 200], "credentials": { "googleSheetsOAuth2Api": { "id": "SET_GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets OAuth2" } } },
    { "parameters": { "jsCode": "const rows = $input.first().json.values || []; const headers = rows.shift() || []; const products = rows.map((r,i) => ({...Object.fromEntries(headers.map((h,j) => [h, r[j] || ''])), rowNumber:i+2})); const eligible = products.find(p => (p.status || 'queued').toLowerCase() === 'queued' && p.productId && p.name && p.productUrl); if (!eligible) throw new Error('No queued product found'); return [{json: eligible}];" }, "id": "select-product", "name": "Select next queued product", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 200] },
    { "parameters": { "url": "=https://image.pollinations.ai/prompt/{{encodeURIComponent('Premium photorealistic ecommerce product photograph of '+$json.name+', isolated on a clean pale aqua studio background, realistic product proportions, no text, square composition')}}?width=1024&height=1024&nologo=true", "options": { "response": { "response": { "responseFormat": "file" } } } }, "id": "generate-image", "name": "Generate product image", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 80], "retryOnFail": true, "maxTries": 3 },
    { "parameters": { "method": "POST", "url": "https://api.groq.com/openai/v1/chat/completions", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.GROQ_API_KEY}}" }, { "name": "Content-Type", "value": "application/json" }] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"model\":\"llama-3.3-70b-versatile\",\"temperature\":0.7,\"messages\":[{\"role\":\"system\",\"content\":\"Write one truthful Instagram caption under 180 words, with 5 relevant hashtags. Do not invent certifications or health claims. Return caption only.\"},{\"role\":\"user\",\"content\":\"Product: {{$('Select next queued product').item.json.name}}. Details: {{$('Select next queued product').item.json.description}}. Link: {{$('Select next queued product').item.json.productUrl}}\"}]}" }, "id": "caption", "name": "Generate caption with Groq", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 320], "retryOnFail": true, "maxTries": 3 },
    { "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} }, "id": "merge-media-caption", "name": "Combine image and caption", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [900, 200] },
    { "parameters": { "method": "POST", "url": "=https://api.cloudinary.com/v1_1/{{$env.CLOUDINARY_CLOUD_NAME}}/image/upload", "sendBody": true, "contentType": "multipart-form-data", "bodyParameters": { "parameters": [{ "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" }, { "name": "upload_preset", "value": "{{$env.CLOUDINARY_UNSIGNED_UPLOAD_PRESET}}" }, { "name": "folder", "value": "califnco-instagram" }] } }, "id": "upload-image", "name": "Upload image to Cloudinary", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 200], "retryOnFail": true, "maxTries": 3 },
    { "parameters": { "method": "POST", "url": "=https://graph.facebook.com/v21.0/{{$env.INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": { "parameters": [{ "name": "image_url", "value": "={{$json.secure_url}}" }, { "name": "caption", "value": "={{$('Generate caption with Groq').item.json.choices[0].message.content}}" }, { "name": "access_token", "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}" }] } }, "id": "create-container", "name": "Create Instagram media container", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1320, 200], "retryOnFail": true, "maxTries": 3 },
    { "parameters": { "amount": 30, "unit": "seconds" }, "id": "wait", "name": "Wait for media processing", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [1540, 200] },
    { "parameters": { "method": "POST", "url": "=https://graph.facebook.com/v21.0/{{$env.INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media_publish", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": { "parameters": [{ "name": "creation_id", "value": "={{$('Create Instagram media container').item.json.id}}" }, { "name": "access_token", "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}" }] } }, "id": "publish", "name": "Publish to Instagram", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1760, 200], "retryOnFail": true, "maxTries": 3 },
    { "parameters": { "method": "PUT", "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{$env.GOOGLE_SHEETS_DOCUMENT_ID}}/values/Products!D{{$('Select next queued product').item.json.rowNumber}}:G{{$('Select next queued product').item.json.rowNumber}}?valueInputOption=USER_ENTERED", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"values\":[[\"published\",\"{{$('Upload image to Cloudinary').item.json.secure_url}}\",\"{{$json.id}}\",\"{{$now.toISO()}}\"]]}" }, "id": "mark-published", "name": "Mark product as published", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1980, 200], "credentials": { "googleSheetsOAuth2Api": { "id": "SET_GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets OAuth2" } } },
    { "parameters": { "method": "POST", "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{$env.GOOGLE_SHEETS_DOCUMENT_ID}}/values/History!A:F:append?valueInputOption=USER_ENTERED", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"values\":[[\"{{$('Select next queued product').item.json.productId}}\",\"{{$('Select next queued product').item.json.name}}\",\"{{$('Select next queued product').item.json.productUrl}}\",\"{{$('Upload image to Cloudinary').item.json.secure_url}}\",\"{{$('Generate caption with Groq').item.json.choices[0].message.content}}\",\"{{$json.id}} · {{$now.toISO()}}\"]]}" }, "id": "history", "name": "Append posting history", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2200, 200], "credentials": { "googleSheetsOAuth2Api": { "id": "SET_GOOGLE_SHEETS_CREDENTIAL_ID", "name": "Google Sheets OAuth2" } } }
  ],
  "connections": {
    "Daily at 09:00": { "main": [[{ "node": "Read product schedule", "type": "main", "index": 0 }]] },
    "Read product schedule": { "main": [[{ "node": "Select next queued product", "type": "main", "index": 0 }]] },
    "Select next queued product": { "main": [[{ "node": "Generate product image", "type": "main", "index": 0 }, { "node": "Generate caption with Groq", "type": "main", "index": 0 }]] },
    "Generate product image": { "main": [[{ "node": "Combine image and caption", "type": "main", "index": 0 }]] },
    "Generate caption with Groq": { "main": [[{ "node": "Combine image and caption", "type": "main", "index": 1 }]] },
    "Combine image and caption": { "main": [[{ "node": "Upload image to Cloudinary", "type": "main", "index": 0 }]] },
    "Upload image to Cloudinary": { "main": [[{ "node": "Create Instagram media container", "type": "main", "index": 0 }]] },
    "Create Instagram media container": { "main": [[{ "node": "Wait for media processing", "type": "main", "index": 0 }]] },
    "Wait for media processing": { "main": [[{ "node": "Publish to Instagram", "type": "main", "index": 0 }]] },
    "Publish to Instagram": { "main": [[{ "node": "Mark product as published", "type": "main", "index": 0 }]] },
    "Mark product as published": { "main": [[{ "node": "Append posting history", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "califnco-r1"
}
